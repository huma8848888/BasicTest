<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8DDDA">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="200dp"
        android:layout_height="0dp"
        android:background="#ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/content_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#ffffff"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="40dp"
        android:textColor="#F44336"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/scrollView"
        android:text="当前需要绘制:"/>
    <TextView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="40dp"
        android:textColor="#F44336"
        app:layout_constraintStart_toEndOf="@id/notification"
        app:layout_constraintTop_toTopOf="@id/notification"
        app:layout_constraintBottom_toBottomOf="@id/notification"
        />
    <TextView
        android:id="@+id/item_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:textColor="#F44336"
        app:layout_constraintTop_toBottomOf="@id/notification"
        app:layout_constraintStart_toStartOf="@id/notification"
        app:layout_constraintEnd_toEndOf="@id/icon"
        android:text="每一项需要绘制1000次"/>

    <com.huitongzhiyuan.testapplication.pen.HandWriteView
        android:id="@+id/canvas"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@id/notification"
        app:layout_constraintStart_toStartOf="@id/notification"
        app:layout_constraintTop_toBottomOf="@id/item_count" />
    <Button
        android:id="@+id/save"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:layout_marginTop="10dp"
        android:text="保存笔迹"
        app:layout_constraintStart_toStartOf="@id/canvas"
        app:layout_constraintEnd_toEndOf="@id/canvas"
        app:layout_constraintTop_toBottomOf="@id/canvas"/>
    <Button
        android:id="@+id/clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="清除签名"
        app:layout_constraintStart_toStartOf="@id/save"
        app:layout_constraintEnd_toEndOf="@id/save"
        app:layout_constraintTop_toBottomOf="@id/save"/>
</androidx.constraintlayout.widget.ConstraintLayout>
