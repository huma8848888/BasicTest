<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark">


    <androidx.cardview.widget.CardView
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/TextView_MainActivity_Save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存签名" />

            <TextView
                android:id="@+id/TextView_MainActivity_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="清除签名" />

            <TextView
                android:id="@+id/TextView_MainActivity_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginLeft="16dp"
                android:text="居中签名" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="40dp"
        android:textColor="#F44336"
        app:layout_constraintTop_toBottomOf="@id/tab_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="当前需要画:对勾"/>

    <com.example.basictest.CustomSignatureView
        android:id="@+id/CustomSignatureView_MainActivity_Canvas"
        android:layout_width="224dp"
        android:layout_height="224dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/notification" />
    <Button
        android:id="@+id/save"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="保存画像"
        app:layout_constraintStart_toStartOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintEnd_toEndOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintTop_toBottomOf="@id/CustomSignatureView_MainActivity_Canvas"/>
    <TextView
        android:id="@+id/right_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前对勾数\n(总共100个)"
        app:layout_constraintStart_toStartOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintTop_toBottomOf="@id/save" />

    <TextView
        android:id="@+id/right_icon_nums"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintStart_toStartOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintTop_toBottomOf="@id/save"
        tools:text="3" />

    <TextView
        android:id="@+id/wrong_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前对叉数\n(总共100个)"
        app:layout_constraintStart_toStartOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintTop_toBottomOf="@id/right_icon" />

    <TextView
        android:id="@+id/wrong_icon_nums"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintStart_toStartOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintBottom_toBottomOf="@id/wrong_icon"
        tools:text="5" />

    <EditText
        android:id="@+id/name_edit"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:textColor="#ffffff"
        tools:text="名字"
        app:layout_constraintStart_toStartOf="@id/CustomSignatureView_MainActivity_Canvas"
        app:layout_constraintTop_toBottomOf="@id/wrong_icon" />

    <Button
        android:id="@+id/confirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="名字确认"
        app:layout_constraintBottom_toBottomOf="@id/name_edit"
        app:layout_constraintStart_toEndOf="@id/name_edit"/>
</androidx.constraintlayout.widget.ConstraintLayout>
